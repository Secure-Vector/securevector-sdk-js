{
  "name": "@securevector/sdk",
  "version": "6.0.1",
  "description": "Security and observability for AI agents, for Node. One import gives any TypeScript or JavaScript agent tool-call verdicts and model-run traces in the SecureVector local app. Zero runtime dependencies.",
  "keywords": [
    "securevector",
    "ai-security",
    "llm-security",
    "prompt-injection",
    "agent-security",
    "observability",
    "tracing",
    "otlp",
    "gen-ai",
    "guardrails"
  ],
  "homepage": "https://securevector.io",
  "bugs": "https://github.com/Secure-Vector/securevector-sdk-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Secure-Vector/securevector-sdk-js.git"
  },
  "license": "Apache-2.0",
  "author": "SecureVector",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/fixup-dist.mjs",
    "typecheck": "tsc -p tsconfig.types.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:live": "node --test test/live.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
